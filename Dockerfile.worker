FROM node:20-alpine

WORKDIR /app

# Copy package.json first
COPY package*.json ./

# Copy prisma folder so postinstall can find schema
COPY prisma ./prisma

# Install dependencies (postinstall will now work)
RUN npm install

# Copy rest of the project
COPY . .

# Install tsx globally
RUN npm install -g tsx

# Run worker
CMD ["tsx", "worker/worker.ts"]